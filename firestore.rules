rules_version = '2';

// ============================================================
// GOOD VIBES 🌊 — Regras de Segurança do Firestore
//
// Como publicar (uma das opções):
//   a) Firebase Console → Firestore Database → Regras → cole este
//      arquivo → "Publicar"   (2 minutos, recomendado)
//   b) Firebase CLI:  firebase deploy --only firestore:rules
//
// ⚠️  Sem publicar estas regras, contas que NÃO são a do dono do
// projeto veem "Missing or insufficient permissions" em TUDO
// (perfil, feed, chat e inbox) — exatamente o erro relatado.
//
// 🔥 ATUALIZADO (Arena: convites diretos + correção da query de
//    'winner'): publique de novo no Console depois de substituir.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- PERFIS ----------
    // Qualquer membro pode LER perfis (necessário para busca de
    // pessoas, contatos do chat e modal de PIX do criador).
    // Cada um só pode ESCREVER no próprio documento.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      // Extrato pessoal: só o dono lê/escreve, e ninguém altera depois
      match /ledger/{entryId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // ---------- FEED ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      // Curtir/descurtir e votar na enquete mexem SÓ nos contadores.
      // Conteúdo (texto, autor, mídia) é imutável para outras pessoas.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'dislikes', 'enquete', 'reactions']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ---------- EMPRÉSTIMOS (Banco do Refúgio) ----------
    // Dono cria e administra o próprio empréstimo; quem está com 30+ dias de
    // atraso fica público na Caderneta dos Devedores (publicShame = true).
    match /loans/{loanId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.principal is number
        && request.resource.data.principal >= 50
        && request.resource.data.totalDue is number
        && request.resource.data.totalDue >= request.resource.data.principal
        && request.resource.data.repaid == 0
        && request.resource.data.status == 'active'
        && request.resource.data.publicShame is bool;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.publicShame == true);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['repaid', 'status', 'paidAt', 'publicShame']);
      allow delete: if false;
    }

    // ---------- QUADRO DE FREELAS (trabalho definido pelos usuários) ----------
    // Qualquer membro publica uma tarefa com recompensa (escrow debitado na
    // publicação). Autor e trabalhador são as únicas partes que podem mexer.
    match /jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.poster == request.auth.uid
        && request.resource.data.posterName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 80
        && request.resource.data.reward is number
        && request.resource.data.reward >= 10
        && request.resource.data.reward <= 10000
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['poster', 'posterName', 'title', 'desc', 'reward', 'status', 'workerId', 'workerName', 'reviewAt', 'acceptedAt', 'createdAt', 'cancelledAt', 'paidAt']);
      allow read: if signedIn();
      // Claim de freela ABERTO: quem aceita tem que virar o worker, sem mexer no resto
      function jobClaimIsValid() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'accepted'
          && request.resource.data.workerId == request.auth.uid
          && request.resource.data.title == resource.data.title
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workerId', 'workerName', 'acceptedAt']);
      }
      allow update: if signedIn()
        && (resource.data.poster == request.auth.uid
            || resource.data.workerId == request.auth.uid
            || jobClaimIsValid())
        && request.resource.data.poster == resource.data.poster
        && request.resource.data.reward == resource.data.reward;
      allow delete: if false;
    }

    // ---------- PRESENTES (presentes entre membros) ----------
    // Envio: quem cria manda constando como remetente.
    // Resgate: só o destinatário lê e marca como 'claimed'.
    match /gifts/{giftId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'status', 'createdAt', 'gold', 'materialId', 'materialQty', 'type', 'jobId', 'marketId'])
        && (request.resource.data.gold is number || request.resource.data.materialId is string)
        && (!request.resource.data.keys().hasAny(['gold']) || request.resource.data.gold > 0)
        && (!request.resource.data.keys().hasAny(['materialQty']) || request.resource.data.materialQty > 0);
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt'])
        && request.resource.data.status == 'claimed';
      allow delete: if false;
    }


    // ---------- MERCADO 🛒 (venda entre jogadores) ----------
    // O vendedor posta o item (escrow: sai do baú no anúncio). Quem compra
    // marca como vendido; o pagamento vai num doc em gifts (tipo 'market'),
    // resgatado pelo vendedor quando abrir o app — mesmo padrão dos freelas.
    match /market/{listingId} {
      allow create: if signedIn()
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.sellerName is string
        && request.resource.data.itemId is string
        && request.resource.data.qty is number
        && request.resource.data.qty >= 1
        && request.resource.data.priceEach is number
        && request.resource.data.priceEach >= 1
        && request.resource.data.price is number
        && request.resource.data.price >= request.resource.data.priceEach
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['seller', 'sellerName', 'itemId', 'qty', 'priceEach', 'price', 'status', 'buyerId', 'buyerName', 'createdAt', 'soldAt', 'cancelledAt']);
      allow read: if signedIn();
      // Compra por OUTRO jogador (aberto→vendido) ou retirada pelo próprio vendedor
      function marketBuyIsValid() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'sold'
          && request.resource.data.buyerId == request.auth.uid
          && resource.data.seller != request.auth.uid
          && request.resource.data.seller == resource.data.seller
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'buyerId', 'buyerName', 'soldAt']);
      }
      function marketCancelIsValid() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && resource.data.seller == request.auth.uid
          && request.resource.data.seller == resource.data.seller
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']);
      }
      allow update: if signedIn() && (marketBuyIsValid() || marketCancelIsValid());
      allow delete: if false;
    }

    // ---------- CHATS DE CANAL (Global e Grupos) ----------
    match /chats_global/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    match /chats_groups/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- MENSAGENS DIRETAS ----------
    // Salas no formato dm_{uidA}_{uidB} (uids ordenados por quem
    // criou). Só quem tem o próprio uid no nome da sala lê/escreve.
    match /{dmRoom}/{messageId} {
      allow read: if signedIn()
        && dmRoom.matches('dm_.*' + request.auth.uid + '.*');
      allow create: if signedIn()
        && dmRoom.matches('dm_.*' + request.auth.uid + '.*')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- ÍNDICE DE PVs ----------
    // Resumo da última mensagem por conversa (dm_{uidA}_{uidB}).
    // É o que permite notificar MENSAGENS PRIVADAS mesmo com o app fechado.
    match /dms/{room} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // ---------- ARENA ⚔️ (cartas criadas pelos jogadores) ----------
    // Qualquer membro lê cartas (decks alheios são públicos). Autor edita/apaga.
    match /cards/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.emoji is string
        && request.resource.data.category in ['dano','dano_fogo','dano_agua','dano_ar','dano_terra','cura','defesa','defesa_magica','invocacao','estrutura']
        && request.resource.data.power is number
        && request.resource.data.power >= 1 && request.resource.data.power <= 5
        && request.resource.data.cost is number
        && request.resource.data.cost >= 1 && request.resource.data.cost <= 5
        && request.resource.data.flavor is string
        && request.resource.data.flavor.size() <= 120;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- ARENA ⚔️ (partidas ao vivo + apostas em escrow) ----------
    // Fluxo: challenger cria ('waiting' público no mural, OU 'invited'
    // endereçado a um nick específico) com a aposta dele já debitada →
    // outro jogador aceita ('active', aposta dele debitada) → jogo por
    // turnos → 'finished' (vencedor) → vencedor resgata o pote ('settled').
    //
    // ⚠️ NUNCA faça query por 'winner' == uid: estas regras não conseguem
    //    provar que o vencedor é playerA ou playerB dentro de uma query de
    //    lista, e o Firestore RECUSA A QUERY INTEIRA com
    //    "Missing or insufficient permissions" — esse era o erro do host.
    //    O cliente busca por playerA/playerB (que a regra prova) e filtra
    //    no aparelho.
    //
    // Convites diretos: status 'invited' + invitedTo = uid do convidado.
    // Só o convidado e o criador leem; o convite NÃO aparece no mural
    // (o mural só lista 'waiting').
    match /arena_matches/{matchId} {
      allow read: if signedIn()
        && (resource.data.status == 'waiting'
            || resource.data.playerA == request.auth.uid
            || resource.data.playerB == request.auth.uid
            || (resource.data.keys().hasAny(['invitedTo']) && resource.data.invitedTo == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.playerA == request.auth.uid
        && request.resource.data.playerAName is string
        && request.resource.data.playerB == ''
        && request.resource.data.turn == 'A'
        && request.resource.data.stakeA is map
        && request.resource.data.stakeA.gold is number
        && request.resource.data.stakeA.gold >= 0
        && request.resource.data.stakeA.cosmetics is list
        && request.resource.data.stakeB is map
        && request.resource.data.hpA == 60 && request.resource.data.hpB == 60
        && (
             (request.resource.data.status == 'waiting')
             || (request.resource.data.status == 'invited'
                 && request.resource.data.invitedTo is string
                 && request.resource.data.invitedTo != request.auth.uid)
           );
      function playersOf() {
        return [resource.data.playerA, resource.data.playerB];
      }
      function isPlayer() {
        return signedIn() && request.auth.uid in playersOf();
      }
      // Aceitar (waiting/invited→active): aceitante vira playerB.
      // Convite ('invited') só pode ser aceito pelo convidado endereçado.
      function acceptIsValid() {
        return (resource.data.status == 'waiting'
                || (resource.data.status == 'invited' && resource.data.invitedTo == request.auth.uid))
          && request.resource.data.status == 'active'
          && request.resource.data.playerB == request.auth.uid
          && request.resource.data.playerA == resource.data.playerA
          && request.resource.data.playerB != resource.data.playerA
          && request.resource.data.stakeA.gold == resource.data.stakeA.gold
          && request.resource.data.stakeB.gold is number
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'playerB', 'playerBName', 'playerBAvatar', 'stakeB', 'potGold', 'turn', 'turnNumber', 'deckB', 'handB', 'treeB', 'catCountB', 'upgB', 'relicsB', 'acceptedAt', 'log']);
      }
      // Jogar um turno (active→active) ou encerrar ('finished')
      function playIsValid() {
        return resource.data.status == 'active'
          && isPlayer()
          && request.resource.data.playerA == resource.data.playerA
          && request.resource.data.playerB == resource.data.playerB
          && request.resource.data.potGold == resource.data.potGold
          && (request.resource.data.status == 'active' || request.resource.data.status == 'finished' || request.resource.data.status == 'cancelled')
          && (!request.resource.data.keys().hasAny(['winner'])
              || request.resource.data.winner == ''
              || request.resource.data.winner == resource.data.playerA
              || request.resource.data.winner == resource.data.playerB);
      }
      // Resgate do pote pelo vencedor (finished→settled)
      function settleIsValid() {
        return resource.data.status == 'finished'
          && resource.data.winner == request.auth.uid
          && request.resource.data.status == 'settled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'settledAt']);
      }
      // Cancelar partida aguardando/convite pendente (só o criador)
      function cancelWaitingIsValid() {
        return (resource.data.status == 'waiting' || resource.data.status == 'invited')
          && resource.data.playerA == request.auth.uid
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt']);
      }
      // Convidado RECUSA o convite (invited→cancelled). A aposta do
      // challenger fica retida e é ele quem a resgata — veja markRefundedIsValid.
      function declineIsValid() {
        return resource.data.status == 'invited'
          && resource.data.invitedTo == request.auth.uid
          && resource.data.playerB == ''
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'declinedAt', 'declinedBy']);
      }
      // Challenger marca a PRÓPRIA aposta retida como devolvida (uma vez só)
      function markRefundedIsValid() {
        return resource.data.status == 'cancelled'
          && resource.data.playerA == request.auth.uid
          && resource.data.stakeA.refunded != true
          && request.resource.data.stakeA.refunded == true
          && request.resource.data.stakeA.gold == resource.data.stakeA.gold
          && request.resource.data.stakeA.cosmetics == resource.data.stakeA.cosmetics
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stakeA']);
      }
      allow update: if signedIn() && (acceptIsValid() || playIsValid() || settleIsValid() || cancelWaitingIsValid() || declineIsValid() || markRefundedIsValid());
      allow delete: if false;
    }

    // ---------- INBOX (notificações de comentário) ----------
    match /inbox/{notifId} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.to is string
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.type == 'comment'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      // Destinatário pode marcar como lida ou apagar
      allow update, delete: if signedIn() && resource.data.to == request.auth.uid;
    }
  }
}
