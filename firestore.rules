rules_version = '2';

// ============================================================
// GOOD VIBES 🌊 — Regras de Segurança do Firestore
//
// Como publicar (uma das opções):
//   a) Firebase Console → Firestore Database → Regras → cole este
//      arquivo → "Publicar"   (2 minutos, recomendado)
//   b) Firebase CLI:  firebase deploy --only firestore:rules
//
// ⚠️  Sem publicar estas regras, contas que NÃO são a do dono do
// projeto veem "Missing or insufficient permissions" em TUDO
// (perfil, feed, chat e inbox) — exatamente o erro relatado.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- PERFIS ----------
    // Qualquer membro pode LER perfis (necessário para busca de
    // pessoas, contatos do chat e modal de PIX do criador).
    // Cada um só pode ESCREVER no próprio documento.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;

      // Extrato pessoal: só o dono lê/escreve, e ninguém altera depois
      match /ledger/{entryId} {
        allow read, create: if signedIn() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // ---------- FEED ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      // Curtir/descurtir e votar na enquete mexem SÓ nos contadores.
      // Conteúdo (texto, autor, mídia) é imutável para outras pessoas.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'dislikes', 'enquete', 'reactions']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    // ---------- EMPRÉSTIMOS (Banco do Refúgio) ----------
    // Dono cria e administra o próprio empréstimo; quem está com 30+ dias de
    // atraso fica público na Caderneta dos Devedores (publicShame = true).
    match /loans/{loanId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.principal is number
        && request.resource.data.principal >= 50
        && request.resource.data.totalDue is number
        && request.resource.data.totalDue >= request.resource.data.principal
        && request.resource.data.repaid == 0
        && request.resource.data.status == 'active'
        && request.resource.data.publicShame is bool;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || resource.data.publicShame == true);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['repaid', 'status', 'paidAt', 'publicShame']);
      allow delete: if false;
    }

    // ---------- QUADRO DE FREELAS (trabalho definido pelos usuários) ----------
    // Qualquer membro publica uma tarefa com recompensa (escrow debitado na
    // publicação). Autor e trabalhador são as únicas partes que podem mexer.
    match /jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.poster == request.auth.uid
        && request.resource.data.posterName is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 80
        && request.resource.data.reward is number
        && request.resource.data.reward >= 10
        && request.resource.data.reward <= 10000
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['poster', 'posterName', 'title', 'desc', 'reward', 'status', 'workerId', 'workerName', 'reviewAt', 'acceptedAt', 'createdAt', 'cancelledAt', 'paidAt']);
      allow read: if signedIn();
      // Claim de freela ABERTO: quem aceita tem que virar o worker, sem mexer no resto
      function jobClaimIsValid() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'accepted'
          && request.resource.data.workerId == request.auth.uid
          && request.resource.data.title == resource.data.title
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workerId', 'workerName', 'acceptedAt']);
      }
      allow update: if signedIn()
        && (resource.data.poster == request.auth.uid
            || resource.data.workerId == request.auth.uid
            || jobClaimIsValid())
        && request.resource.data.poster == resource.data.poster
        && request.resource.data.reward == resource.data.reward;
      allow delete: if false;
    }

    // ---------- PRESENTES (presentes entre membros) ----------
    // Envio: quem cria manda constando como remetente.
    // Resgate: só o destinatário lê e marca como 'claimed'.
    match /gifts/{giftId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.fromName is string
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'status', 'createdAt', 'gold', 'materialId', 'materialQty', 'type', 'jobId'])
        && (request.resource.data.gold is number || request.resource.data.materialId is string)
        && (!request.resource.data.keys().hasAny(['gold']) || request.resource.data.gold > 0)
        && (!request.resource.data.keys().hasAny(['materialQty']) || request.resource.data.materialQty > 0);
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt'])
        && request.resource.data.status == 'claimed';
      allow delete: if false;
    }

    // ---------- CHATS DE CANAL (Global e Grupos) ----------
    match /chats_global/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    match /chats_groups/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- MENSAGENS DIRETAS ----------
    // Salas no formato dm_{uidA}_{uidB} (uids ordenados por quem
    // criou). Só quem tem o próprio uid no nome da sala lê/escreve.
    match /{dmRoom}/{messageId} {
      allow read: if signedIn()
        && dmRoom.matches('dm_.*' + request.auth.uid + '.*');
      allow create: if signedIn()
        && dmRoom.matches('dm_.*' + request.auth.uid + '.*')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update, delete: if false;
    }

    // ---------- ÍNDICE DE PVs ----------
    // Resumo da última mensagem por conversa (dm_{uidA}_{uidB}).
    // É o que permite notificar MENSAGENS PRIVADAS mesmo com o app fechado.
    match /dms/{room} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;
    }

    // ---------- INBOX (notificações de comentário) ----------
    match /inbox/{notifId} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.to is string
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.type == 'comment'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      // Destinatário pode marcar como lida ou apagar
      allow update, delete: if signedIn() && resource.data.to == request.auth.uid;
    }
  }
}
